<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        
        <title>Macroking-home</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        <link href="/css/index.css" rel="stylesheet">
        <link href ="/css/mainpage.css" rel="stylesheet">
    </head>
<body>
    <img id="backgroundImg" src="./images/background.jpg">
    <%- include('SimpleNavbar.ejs') %>
    <div class="interesting-shape"> 
        <form class="form-horizontal form-group" action="/recipes/new" method="post" name="recipe">
            
            <h2 class="formelement">Insert recipe</h2>
            <label class="formelement">
                Name:
            </label>
                <input class="formelement form-control" id="inputEmail3"type="text" name="name">
            <label class="formelement">
               Ingredients:  
            </label>
            <textarea class="form-control formelement"  name="ingredients" rows="5" cols="20"></textarea>
            <label class="formelement">
                Preparation mode:
            </label>
            <textarea class="form-control formelement" name="preparationmode" rows="10" cols="40"></textarea>
            <label class="formelement">
                KiloCalories:
            </label>
            <input class="form-control formelement" type="text" name="calories">
            <label class="formelement">
                Macronutrients:
            </label>
            <textarea class="form-control formelement" name="macronutrients"></textarea>
            <input id="choose-file" class="formelement" type="file" placeholder='upload a photo' name="image">
            <input id="create-btn" class="form-control formelement btn btn-primary mb-2"  type="submit" value="Create recipe">
            <% if (error) { %>    
                <div class="alert alert-warning error fade show" role="alert">Please complete the <%= error %> field!</div>      
            <% } %>
            
                     
                 
         
        </form>
    </div> 
        <h1 class="backgroundTitle">Create your own recipies.<br>Counting calories <br>doesn't have to be <br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;hard!</h1>
        
        
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
