<html>
    <%- include('importHead.ejs') %>
<body>
    <%- include('importNavbar.ejs') %>
    <div class="container">
        <h1>Insert Food Name</h1>
        <form action="/mainpage" method="post">
            <label for="foodName">Food Name:</label>
            <input type="text" id="foodName" name="foodName" placeholder="Enter food name...">
            <input type="submit" value="Submit">
        </form>
        <% if (aliment!=undefined) { %>
            <h2>product:<%= aliment.name %></h2>
            <h3>calories:<%= aliment.calories %></h3>
            <h3>protein:<%= aliment.protein %></h3>
            <h3>carbohydrates:<%= aliment.carbs %></h3>
            <h3>fats:<%= aliment.fat %></h3>

        <% } %>
        
    </div>
</body>
</html>
