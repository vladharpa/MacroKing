<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        
        <title>Macroking-home</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        <link href="/css/index.css" rel="stylesheet">
        <link href ="/css/mainpage.css" rel="stylesheet">
    </head>
<body>
    <img id="backgroundImg" src="/images/mainpage.jpg">
    <%- include('SimpleNavbar.ejs') %>
    
        <form action="/mainpage" method="post" name="recipe">
            <h2 class="formelement">Insert recipe</h2>
            <label class="formelement">
                Name:
            </label>
                <input class="formelement" type="text" name="Name">
            <label class="formelement">
               Ingredients:  
            </label>
            <textarea class="formelement"  name="Ingredients" rows="5" cols="20"></textarea>
            <label class="formelement">
                Preparation mode:
            </label>
            <textarea class="formelement" name="PreparationMode" rows="10" cols="40"></textarea>
            <label class="formelement">
                KiloCalories:
            </label>
            <input class="formelement" type="text" name="Calories">
            <label class="formelement">
                Macronutrients:
            </label>
            <textarea class="formelement" name="Macronutrients"></textarea>
            <input class="formelement" type="file" placeholder='upload a photo' name="image">
            <input class="formelement" type="submit" value="create recipe">
            <% if (error == 'name') { %>    
                <div class="alert alert-warning error fade show" role="alert">Please complete the <%= error %> field!</div>      
            <% } else if (error == 'ingredients') { %>
                <div class="alert alert-warning error fade show" role="alert">Please complete the <%= error %> field!</div> 
            <% } else if (error == 'preparation') { %>
                <div class="alert alert-warning error fade show" role="alert">Please complete the <%= error %> field!</div> 
            <% } else if (error == 'kcalories') { %>
                <div class="alert alert-warning error fade show" role="alert">Please complete the <%= error %> field!</div> 
            <% } else if (error == 'macronutrients') { %>
                <div class="alert alert-warning error fade show" role="alert">Please complete the <%= error %> field!</div> 
            <% } else if (error == 'image') { %>
                <div class="alert alert-warning error fade show" role="alert">Please complete the <%= error %> field!</div> 
            <% } %>
                         
                     
                 
             
        </form>
        
        
        
        
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
